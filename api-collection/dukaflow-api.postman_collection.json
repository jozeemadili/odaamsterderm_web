{
  "info": {
    "_postman_id": "71958cec-ef56-40a5-a1e0-9a1f2ac61671",
    "name": "DukaFlow Mobile API (v1)",
    "description": "REST API backing the DukaFlow Flutter mobile app. Token auth via Laravel Sanctum: call Register/Login/Google sign-in once, the token is saved automatically into {{token}} for every other request. Set {{base_url}} to your environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://dukaflow-production-lfgbd3.laravel.cloud/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Google sign-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "Verifies a Google ID token (from Flutter's native Google Sign-In, requested with serverClientId = the web GOOGLE_CLIENT_ID). Returns a token if the user already exists, or {needs_registration:true, google_id, email, name} if they need to complete registration via Register.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"PASTE_A_REAL_GOOGLE_ID_TOKEN_HERE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) {",
                  "        pm.collectionVariables.set('token', body.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Self-service merchant registration. Omit `password` and pass `google_id` instead when completing a Google sign-up (from the `needs_registration` response of /auth/google).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"Mama Amina Duka\",\n  \"owner_name\": \"Amina Juma\",\n  \"phone\": \"+255700000001\",\n  \"business_type\": \"Retail\",\n  \"region\": \"Dar es Salaam\",\n  \"email\": \"amina@example.com\",\n  \"password\": \"password123\",\n  \"google_id\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) {",
                  "        pm.collectionVariables.set('token', body.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
